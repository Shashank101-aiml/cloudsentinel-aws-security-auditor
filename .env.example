# CloudSentinel Configuration File (.env)
# Copy this file to .env and customize as needed. DO NOT commit .env to version control!

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration
# Default is local SQLite. For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/cloudsentinel
DATABASE_URL=sqlite:///./cloudsentinel.db

# AWS Configuration (Optional: default uses AWS CLI credentials / default chain)
# Leave blank to use active AWS CLI profile or default credentials chain
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
AWS_ASSUME_ROLE_ARN=

# Risk Scoring Policy Weights
WEIGHT_CRITICAL=10.0
WEIGHT_HIGH=7.0
WEIGHT_MEDIUM=4.0
WEIGHT_LOW=2.0
WEIGHT_INFO=0.0

# Demo Mode Settings
DEMO_MODE_DEFAULT=true
